# Hostinger serves this repo's root as the site, so everything committed
# here is public unless a rule below says otherwise. Two jobs: keep the
# repo's non-site files out of reach, and set the browser security headers
# a static site should have. Then the SPA fallback.
#
# The same hardening block is in applicants-site and ds-site's .htaccess;
# change one, change all three (micahburger.com sites, 2026-11-11).

# ---- security headers ----
# No login, forms or database here, so these are about the browser, not the
# server: HTTPS only, no guessing a file's type, framing only by Micah's own
# sites, not leaking full URLs to other sites, and no camera, mic or
# location for any script.
#
# Framing is open to every micahburger.com site, not just this one: the
# prototype viewer (prototypes.micahburger.com) shows these pages in
# iframes, and localhost is allowed for running that viewer in dev. That's
# why it's CSP frame-ancestors and not X-Frame-Options, which can only say
# "this site" or "nobody". upgrade-insecure-requests is repeated because
# setting this header replaces the one Hostinger sends.
#
# HSTS is a year, without includeSubDomains: this is one subdomain and
# shouldn't speak for others.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self' https://micahburger.com https://*.micahburger.com http://localhost:*"
</IfModule>

# A retired address (the 410s below) still shows a person the homepage,
# with the 410 status for crawlers, instead of the server's bare error
# page. The app reads the path, finds no case study, and renders home.
ErrorDocument 410 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---- not part of the site ----
  # The source (app/), the build script, the project notes and any
  # Markdown, scripts, configs, source maps or dotfiles: refused before the
  # "real files" rule below can serve them. Forbidden rather than 404 to
  # match what the host already does for .git. .well-known stays open for
  # the host's SSL certificate checks.
  RewriteRule ^app(/|$) - [F,L]
  RewriteRule \.(md|sh|ts|tsx|map|lock)$ - [F,L,NC]
  RewriteRule (^|/)(package(-lock)?\.json|tsconfig[^/]*\.json|vite\.config\.[a-z]+)$ - [F,L,NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]

  # ---- retired case studies ----
  # WWE, BBC, Rockwell, ABA and FPO were their own pages on the old
  # WordPress site at these same paths; since 2026-11-11 they're previews on
  # /project/archive, each under its own anchor. Once this site is
  # micahburger.com, an old link lands on that project, already open. NE
  # keeps the # from being escaped. A query has to go before the #, and
  # Apache's own carry-over puts it after (where it reads as part of the
  # anchor), so with a query it's written in by hand and the automatic copy
  # dropped (QSD).
  RewriteCond %{QUERY_STRING} .
  RewriteRule ^project/(wwe|bbc|rockwell|aba|fpo)/?$ /project/archive?%{QUERY_STRING}#$1 [R=301,NE,QSD,L]
  RewriteRule ^project/(wwe|bbc|rockwell|aba|fpo)/?$ /project/archive#$1 [R=301,NE,L]

  # ---- the rest of the old WordPress site: gone ----
  # Everything else its sitemap listed (checked 2026-11-11), and
  # WordPress's own addresses, answer 410 Gone: the page existed and won't
  # be back, so search engines drop it rather than keep retrying as they
  # would a 404. Lincoln, Infinity and Opendoor kept their paths here, so
  # they need nothing.
  #
  # /work (the old project grid), /featured-illustrations, /project/lattice
  # and /footer/* (Semplice's footer templates, which got indexed) were
  # redirected for a day, then retired outright: Micah doesn't want the new
  # site pointing at them (2026-11-11). Bots keep trying wp-login.php and
  # xmlrpc.php for years after a site leaves WordPress; this answers them
  # without serving the app's page as if it were real.
  RewriteRule ^(work|featured-illustrations|project/lattice)/?$ - [G,L]
  RewriteRule ^footer(/|$) - [G,L]
  RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/|$) - [G,L]
  RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-signup|wp-trackback)\.php$ - [G,L]

  # ---- SPA fallback ----
  # /project/<slug> and any other app path has no file behind it; without
  # this a direct load or refresh on one returns a real 404 instead of the
  # page.

  # Real files and directories (JS, CSS, images, fonts, etc.) resolve as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # A case study with its own built copy of the page (project/<slug>.html:
  # the same app, with that study's title and link-preview tags in the
  # <head>; see src/data/share.ts) gets that copy. Internal, like the
  # fallback below, so the address stays /project/<slug>.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(project/[a-z0-9-]+)/?$ $1.html [L]

  # Everything else falls back to the SPA shell so the client router can
  # take over: an internal rewrite, not a redirect, so the URL bar (and
  # therefore window.location.pathname) is untouched.
  RewriteRule ^ index.html [L]
</IfModule>
